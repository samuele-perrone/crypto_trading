# Strategy configuration
PAIR=ETH/USD
SMA_FAST=20
SMA_SLOW=30
USD_PER_TRADE=50
STOP_LOSS_PCT=0
TAKE_PROFIT_PCT=0

# Set to "true" to place REAL orders; anything else = dry-run
LIVE=

# Kraken API (only needed when LIVE=true)
# Create at kraken.com -> Settings -> API with ONLY these permissions:
# Query Funds + Create & Modify Orders (never enable Withdraw)
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Position state: path to the SQLite file (created automatically).
# Default: bot_state.db in the repo. On Vercel it falls back to /tmp/bot_state.db,
# which is WIPED between invocations - point this at durable storage there.
BOT_DB_PATH=

# Telegram trade notifications (optional)
# Token from @BotFather; chat id from api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Protects /api/tick from strangers (any random string)
CRON_SECRET=
