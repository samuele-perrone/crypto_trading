# Strategy configuration
PAIR=ETH/USD
SMA_FAST=20
SMA_SLOW=30
USD_PER_TRADE=50
STOP_LOSS_PCT=0
TAKE_PROFIT_PCT=0

# Set to "true" to place REAL orders; anything else = dry-run
LIVE=

# Kraken API (only needed when LIVE=true)
# Create at kraken.com -> Settings -> API with ONLY these permissions:
# Query Funds + Create & Modify Orders (never enable Withdraw)
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Position state. The SQLite file rests in a private Vercel Blob store between
# ticks; `vercel blob create-store` sets BLOB_READ_WRITE_TOKEN for you.
# Without a token the bot uses a plain local file, which is correct off Vercel
# but ephemeral on it.
BLOB_READ_WRITE_TOKEN=
# Optional overrides: local SQLite path, and the object name in the store
# (default: <VERCEL_ENV>/bot_state.db, keeping local runs out of production).
BOT_DB_PATH=
BOT_BLOB_PATHNAME=

# Telegram trade notifications (optional)
# Token from @BotFather; chat id from api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Protects /api/tick from strangers (any random string)
CRON_SECRET=
